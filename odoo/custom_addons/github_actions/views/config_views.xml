<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="github_actions_config_form" model="ir.ui.view">
        <field name="name">github.actions.config.form</field>
        <field name="model">github.actions.config</field>
        <field name="arch" type="xml">
            <form string="GitHub Actions configuration">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Repository">
                            <field name="owner" placeholder="NexusGit-dot"/>
                            <field name="repo" placeholder="nexusgrid"/>
                            <field name="branch" placeholder="main"/>
                        </group>
                        <group string="Options">
                            <field name="api_url"/>
                            <field name="limit"/>
                            <field name="auto_refresh"/>
                            <field name="last_refresh"/>
                        </group>
                    </group>
                    <group string="Access token" groups="base.group_system">
                        <field name="token" placeholder="ghp_..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="github_actions_config_action" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">github.actions.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No configuration.</p>
        </field>
    </record>

</odoo>
